TILLWEB_BASE_URL=https://tillweb.example.org
TILLWEB_TOKEN=<bearer-token-from-emftillweb-toml>

OMS_LOCATION=Spacebar
OMS_LISTEN_HOST=127.0.0.1
OMS_PORT=8081
OMS_POLL_INTERVAL=5

# Dev: return mock order data without contacting the till
OMS_MOCK_MODE=false

# Optional: path to append collected-order log (JSONL, one order per line)
# OMS_COLLECT_LOG=/var/log/spacebar-oms/collected.jsonl

# Optional: path to append ID-check audit log (JSONL, one entry per check)
# OMS_IDCHECK_LOG=/var/log/spacebar-oms/id-checks.jsonl

# Dev against local mock till (see dev/README.md in the top-level repo):
# TILLWEB_BASE_URL=http://127.0.0.1:8765
# TILLWEB_TOKEN=test
# OMS_MOCK_MODE=false
