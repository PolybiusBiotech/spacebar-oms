[Unit]
Description=Spacebar OMS server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/spacebar-oms
EnvironmentFile=/etc/spacebar-oms.env
ExecStart=/usr/bin/node /opt/spacebar-oms/src/server.js
Restart=always
RestartSec=5
User=pi
Group=pi

[Install]
WantedBy=multi-user.target
